<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.twisttype.android">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application android:label="TwistType" android:icon="@drawable/ic_twisttype"
        android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ClipboardEntryActivity" android:exported="true"
            android:label="TT Clipboard" android:icon="@drawable/ic_clipboard_launcher"
            android:theme="@style/ClipboardEntryTheme" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TestActivity" android:exported="false" android:label="Try TwistType" />
        <service android:name=".ExpandService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="TwistType text expansion">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
        <service android:name=".ClipboardService" android:exported="false" />
        <service android:name=".ClipboardTileService" android:exported="true"
            android:label="TT Clipboard" android:icon="@drawable/ic_clipboard_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
